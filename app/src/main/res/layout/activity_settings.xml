<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <CheckBox
        android:id="@+id/chkNotifications"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Notificaciones activadas"
        android:checked="true"
        tools:ignore="HardcodedText,VisualLintButtonSize" />

    <CheckBox
        android:id="@+id/chkAutoDetect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Activar detección automática (Shake/Volumen)"
        android:layout_marginBottom="24dp"
        tools:ignore="HardcodedText,VisualLintButtonSize" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Contactos de Emergencia"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        tools:ignore="HardcodedText" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvContacts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp"
        tools:listitem="@layout/item_contact_placeholder"/>

    <Button
        android:id="@+id/btnAddContact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Añadir Nuevo Contacto"
        android:backgroundTint="#B00020"
        android:layout_marginBottom="8dp"
        tools:ignore="HardcodedText" />

    <Button
        android:id="@+id/btnBackSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Volver"
        tools:ignore="HardcodedText,VisualLintButtonSize" />
</LinearLayout>
