<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <CheckBox
        android:id="@+id/chkNotifications"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="notificaciones_activadas"
        android:checked="true"
        tools:ignore="HardcodedText,VisualLintButtonSize" />

    <CheckBox
        android:id="@+id/chkAutoDetect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="activar detección_automática"
        tools:ignore="HardcodedText,VisualLintButtonSize" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="contactos de emergencia"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        tools:ignore="HardcodedText" />

    <EditText
        android:id="@+id/etContact1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="nombre y teléfono del contacto 1"
        android:inputType=""
        android:minHeight="48dp"
        android:textColorHint="#757575"
        tools:ignore="Autofill,HardcodedText,VisualLintTextFieldSize" />

    <EditText
        android:id="@+id/etContact2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="nombre y teléfono del contacto 2"
        android:inputType=""
        android:minHeight="48dp"
        android:textColorHint="#757575"
        tools:ignore="Autofill,HardcodedText,VisualLintTextFieldSize" />

    <Button
        android:id="@+id/btnBackSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="volver"
        android:layout_marginTop="24dp"
        tools:ignore="HardcodedText,VisualLintButtonSize" />
</LinearLayout>
