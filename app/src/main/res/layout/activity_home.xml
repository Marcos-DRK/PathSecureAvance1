<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PathSecure inicio"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        tools:ignore="HardcodedText" />

    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:background="#DADADA"
        android:layout_marginBottom="16dp"/>

    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stretchColumns="1">

        <TableRow>
            <TextView android:text="Ruta actual"
                tools:ignore="HardcodedText" />
            <TextView android:text="Casa - trabajo" android:textStyle="bold"
                tools:ignore="HardcodedText" />
        </TableRow>

        <TableRow>
            <TextView android:text="Sistema"
                tools:ignore="HardcodedText" />
            <TextView android:text="Activado" android:textColor="#009688" android:textStyle="bold"
                tools:ignore="HardcodedText" />
        </TableRow>

        <TableRow>
            <TextView android:text="Emergencia"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="285dp"
                android:text="Inactivo"
                android:textColor="#B00020"
                android:textStyle="italic"
                tools:ignore="HardcodedText" />
        </TableRow>
    </TableLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp"
        android:gravity="center">

        <Button
            android:id="@+id/btnRoutes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rutas"
            android:layout_marginEnd="12dp"
            tools:ignore="ButtonStyle,HardcodedText" />

        <Button
            android:id="@+id/btnEmergency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/emergencia"
            android:backgroundTint="#B00020"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="12dp"
            tools:ignore="ButtonStyle,HardcodedText" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configuración"
            tools:ignore="ButtonStyle,HardcodedText" />
    </LinearLayout>
    <TextView
        android:id="@+id/txtLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ubicación actual: esperando señal GPS..."
        android:textAlignment="center"
        android:textStyle="italic"
        android:layout_marginTop="16dp"
        tools:ignore="HardcodedText" />

</LinearLayout>
