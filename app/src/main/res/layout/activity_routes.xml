<?xml version="1.0" encoding="utf-8"?>
<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:stretchColumns="1"
    android:padding="16dp"
    android:background="#FAFAFA">

    <TextView
        android:text="Rutas Guardadas"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        android:layout_gravity="center_horizontal"
        tools:ignore="HardcodedText" />

    <TableRow>
        <TextView android:text="1."
            tools:ignore="HardcodedText" />
        <TextView android:text="Casa → Trabajo"
            tools:ignore="HardcodedText" />
        <TextView android:text="Lunes-Viernes"
            tools:ignore="HardcodedText" />
    </TableRow>

    <TableRow>
        <TextView android:text="2."
            tools:ignore="HardcodedText" />
        <TextView android:text="Universidad → Hogar"
            tools:ignore="HardcodedText" />
        <TextView android:text="Sábados"
            tools:ignore="HardcodedText" />
    </TableRow>

    <TableRow>
        <TextView android:text="3."
            tools:ignore="HardcodedText" />
        <TextView android:text="Casa → Gimnasio"
            tools:ignore="HardcodedText" />
        <TextView android:text="Diario"
            tools:ignore="HardcodedText" />
    </TableRow>

    <Button
        android:id="@+id/btnBackRoutes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Volver"
        android:layout_marginTop="24dp"
        tools:ignore="HardcodedText,VisualLintButtonSize" />
</TableLayout>
